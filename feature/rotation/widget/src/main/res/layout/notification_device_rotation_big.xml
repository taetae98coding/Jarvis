<?xml version="1.0" encoding="utf-8"?>
<!-- 펼친 알림. 카드·위젯과 같은 버튼 구성이다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/device_rotation_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_rotation_widget_label" />

    <TextView
        android:id="@+id/device_rotation_status"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/notification_widget_gap" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_rotation_angle_0"
            style="@style/NotificationWidgetButton"
            android:text="0°" />

        <TextView
            android:id="@+id/device_rotation_angle_90"
            style="@style/NotificationWidgetButton"
            android:layout_marginStart="@dimen/notification_widget_gap"
            android:text="90°" />

        <TextView
            android:id="@+id/device_rotation_angle_180"
            style="@style/NotificationWidgetButton"
            android:layout_marginStart="@dimen/notification_widget_gap"
            android:text="180°" />

        <TextView
            android:id="@+id/device_rotation_angle_270"
            style="@style/NotificationWidgetButton"
            android:layout_marginStart="@dimen/notification_widget_gap"
            android:text="270°" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/notification_widget_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_rotation_backward"
            style="@style/NotificationWidgetButton"
            android:text="-90°" />

        <TextView
            android:id="@+id/device_rotation_lock"
            style="@style/NotificationWidgetButton"
            android:layout_marginStart="@dimen/notification_widget_gap" />

        <TextView
            android:id="@+id/device_rotation_forward"
            style="@style/NotificationWidgetButton"
            android:layout_marginStart="@dimen/notification_widget_gap"
            android:text="+90°" />
    </LinearLayout>
</LinearLayout>
