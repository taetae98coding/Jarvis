<?xml version="1.0" encoding="utf-8"?>
<!-- 펼친 알림. 상태 문구를 줄이지 않고 다 보여준다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/system_screen_awake_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/system_screen_awake_widget_label" />

    <TextView
        android:id="@+id/system_screen_awake_status"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/notification_widget_gap" />

    <TextView
        android:id="@+id/system_screen_awake_toggle"
        style="@style/NotificationWidgetButton"
        android:layout_width="match_parent"
        android:layout_weight="0" />
</LinearLayout>
