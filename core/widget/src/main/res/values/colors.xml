<?xml version="1.0" encoding="utf-8"?>
<!--
    알림 RemoteViews 는 SystemUI 테마로 인플레이트되어 앱의 ?attr 색이 풀리지 않는다. 시스템 동적 색 리소스는
    어디서 인플레이트해도 같은 값이라 이것을 쓰고, values-night 로 밝음·어두움을 나눈다.
-->
<resources>
    <color name="notification_widget_button_background">@android:color/system_neutral2_100</color>
    <color name="notification_widget_button_text">@android:color/system_neutral1_900</color>
    <color name="notification_widget_button_selected_background">@android:color/system_accent1_600</color>
    <color name="notification_widget_button_selected_text">@android:color/system_accent1_0</color>
</resources>
